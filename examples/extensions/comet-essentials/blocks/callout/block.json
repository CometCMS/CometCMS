{
  "title": "Callout",
  "description": "An announcement with an optional link.",
  "props": {
    "title": {
      "type": "string",
      "label": "Heading",
      "max": 200,
      "default": "Something worth sharing",
      "placeholder": "Something worth sharing"
    },
    "message": {
      "type": "text",
      "label": "Message",
      "max": 2000,
      "default": "Your custom block is ready.\nEdit this text in the inspector."
    },
    "tone": {
      "type": "enum",
      "label": "Tone",
      "options": [
        "info",
        "success"
      ],
      "default": "info",
      "option_labels": {
        "info": "Information",
        "success": "Success"
      },
      "group": "Appearance"
    },
    "show_link": {
      "type": "bool",
      "label": "Show link",
      "default": true,
      "group": "Link",
      "help": "Adds a link below the message."
    },
    "link_label": {
      "type": "string",
      "label": "Link label",
      "max": 120,
      "default": "Learn more",
      "group": "Link",
      "visible_when": {
        "show_link": true
      }
    },
    "link": {
      "type": "link",
      "label": "Link",
      "default": "#details",
      "group": "Link",
      "visible_when": {
        "show_link": true
      }
    }
  },
  "keywords": [
    "notice",
    "alert",
    "announcement",
    "banner"
  ],
  "variations": [
    {
      "name": "success",
      "title": "Success callout",
      "description": "A confirmation with a check mark.",
      "icon": "mdi:check-circle-outline",
      "props": {
        "tone": "success",
        "title": "All set",
        "show_link": false
      }
    },
    {
      "name": "plain",
      "title": "Note",
      "description": "A short note without a link.",
      "icon": "mdi:note-text-outline",
      "props": {
        "show_link": false,
        "title": "Good to know"
      }
    }
  ]
}
