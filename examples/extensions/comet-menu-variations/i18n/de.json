{
  "$schema": "../../../../schemas/i18n.schema.json",
  "title": "CometCMS - Menü-Varianten",
  "description": "Pills, segmentierte Tabs, ein nummerierter Index, Karten, eine Seitenleiste und Inline-Links aus deinen Website-Menüs, jeweils mit Stilen, Formen und Abständen.",
  "shared_props": {
    "navigation": {
      "label": "Menü"
    },
    "accent": {
      "label": "Akzentfarbe",
      "group": "Farben"
    },
    "surface": {
      "label": "Flächenfarbe",
      "group": "Farben",
      "help": "Hintergrund der Links. Leer lassen, um den des Stils zu verwenden."
    },
    "corners": {
      "label": "Ecken",
      "group": "Form und Abstände",
      "help": "Verwendet die Eckenradien des Themes."
    },
    "density": {
      "label": "Abstände",
      "group": "Form und Abstände",
      "options": {
        "compact": "Kompakt",
        "comfortable": "Angenehm",
        "spacious": "Großzügig"
      }
    },
    "uppercase": {
      "label": "Beschriftungen in Großbuchstaben",
      "group": "Form und Abstände"
    }
  },
  "blocks": {
