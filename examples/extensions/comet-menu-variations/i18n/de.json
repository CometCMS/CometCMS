      "keywords": [
        "menü",
        "kacheln",
        "raster"
      ],
      "props": {
        "style": {
          "label": "Stil",
          "options": {
            "outline": "Kontur",
            "filled": "Gefüllt",
            "elevated": "Erhöht",
            "stripe": "Streifen"
          }
        },
        "columns": {
          "label": "Spalten (Desktop)",
          "group": "Layout",
          "options": {
            "auto": "Automatisch"
          }
        },
        "height": {
          "label": "Kartenhöhe",
          "group": "Layout",
          "options": {
            "auto": "Inhalt",
            "tall": "Hoch"
          }
        },
        "alignment": {
          "label": "Textausrichtung",
          "group": "Layout",
          "options": {
            "start": "Anfang",
            "center": "Mitte"
          }
