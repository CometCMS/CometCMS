{
  "$schema": "../../../../../schemas/background.schema.json",
  "title": "Futuristic Grid",
  "description": "An industrial grid with a scanning light, glowing horizon and technical corner marks behind a section, row or column.",
  "icon": "mdi:grid",
  "keywords": [
    "tech",
    "futuristic",
    "lines"
  ],
  "props": {
    "variant": {
      "type": "enum",
      "label": "Background style",
      "options": [
        "perspective",
        "flat"
      ],
      "default": "perspective",
      "option_labels": {
        "perspective": "Perspective floor",
        "flat": "Flat grid"
      }
    },
    "accent": {
      "use": "accent"
    },
    "secondary": {
      "use": "secondary"
    },
    "intensity": {
      "use": "intensity"
    },
    "motion": {
      "use": "motion"
    },
    "scale": {
      "use": "scale"
    }
  },
  "section": {
    "props": {
      "min_height": "half",
      "vertical_align": "center"
    },
    "style": {
      "background": "text",
      "text_color": "background",
      "link_color": "background"
    }
  }
}
