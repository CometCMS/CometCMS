{
  "$schema": "../../../../../schemas/background.schema.json",
  "title": "Geometric Forms",
  "description": "Floating rings, angular planes and geometric outlines behind a section, row or column.",
  "icon": "mdi:shape-outline",
  "keywords": [
    "shapes",
    "rings",
    "geometric"
  ],
  "props": {
    "variant": {
      "type": "enum",
      "label": "Background style",
      "options": [
        "mixed",
        "rings",
        "angular"
      ],
      "default": "mixed",
      "option_labels": {
        "mixed": "Mixed shapes",
        "rings": "Rings",
        "angular": "Angular"
      }
    },
    "accent": {
      "use": "accent"
    },
    "secondary": {
      "use": "secondary"
    },
    "intensity": {
      "use": "intensity"
    },
    "motion": {
      "use": "motion"
    },
    "scale": {
      "use": "scale"
    }
  },
  "section": {
    "props": {
      "min_height": "half",
      "vertical_align": "center"
    },
    "style": {
      "background": "text",
      "text_color": "background",
      "link_color": "background"
    }
  }
}
