    "accent": {
      "use": "accent"
    },
    "secondary": {
      "use": "secondary"
    },
    "intensity": {
      "use": "intensity"
    },
    "motion": {
      "use": "motion"
    },
    "scale": {
      "use": "scale"
    },
    "padding": {
      "use": "padding"
    },
    "height": {
      "use": "height"
    },
    "align": {
      "use": "align"
    }
  }
}
