{
  "$schema": "../../../../../schemas/block.schema.json",
  "title": "Geometric Forms",
  "description": "Floating rings, angular panels and geometric outlines behind your content.",
  "icon": "mdi:shape-outline",
  "props": {
    "variant": {
      "type": "enum",
      "label": "Background style",
